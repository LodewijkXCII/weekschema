# Postgres connection string (Fly Postgres, Render Postgres, or local)
DATABASE_URL=postgres://weekplanner:weekplanner@localhost:5432/weekplanner

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me

# Public URL where this app is reachable (used by better-auth for callbacks/cookies).
# In productie: http://<pi-lan-ip>:3000 (zelfde adres dat je als Twingate
# Resource registreert, en dat de kiosk-browser op de Pi zelf gebruikt --
# zie DEPLOY.md. Zorg voor een vaste LAN-IP via een DHCP-reservering.)
BETTER_AUTH_URL=http://localhost:3000

# Eigen Anthropic API-key voor het importeren van recepten (URL/tekst/foto ->
# gestructureerd recept). Maak een key aan op https://console.anthropic.com --
# gebruik/kosten lopen op jouw eigen account, niet gedeeld. Zonder deze key
# werkt de rest van de app gewoon door; alleen "Recept importeren" werkt niet.
ANTHROPIC_API_KEY=

# Twingate-connector (voor toegang van buiten je thuisnetwerk, bv. je
# telefoon onderweg). TWINGATE_NETWORK is je tenant-naam; de twee tokens
# genereer je bij het aanmaken van een Remote Network + Connector in de
# Twingate admin console. Zie DEPLOY.md.
TWINGATE_NETWORK=
TWINGATE_ACCESS_TOKEN=
TWINGATE_REFRESH_TOKEN=
